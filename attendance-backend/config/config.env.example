# Copy this file to config.env for local development. Never commit config.env.
PORT=4000
DB_URI=mongodb://127.0.0.1:27017/attendance
JWT_SECRET=replace-with-a-long-random-local-secret
JWT_EXPIRE=5d
COOKIE_EXPIRE=2

# Public OAuth client identifier. A client secret is not used by this app.
GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com
# Comma-separated college accounts allowed to create teacher accounts on first sign-in.
# Must be @nitjsr.ac.in addresses. Removing one does not demote an existing teacher.
TEACHER_EMAILS=teacher@nitjsr.ac.in

# Optional, rehearsal only: comma-separated non-college Google accounts (e.g.
# Gmail) that may sign in as students without being on a class roster. Leave
# empty for production behaviour. An address may appear in only one list, and
# the server rejects a college address here. Removing an address blocks new
# sign-ins and rejects its live session on the next request; the stored user
# row keeps its role.
# TEST_STUDENT_EMAILS=tester1@gmail.com,tester2@gmail.com

# Optional, rehearsal only: comma-separated non-college Google accounts that
# may sign in as teachers without a college Workspace account. Use one for the
# owner/teacher test login; there is no separate admin role. Removing an address
# blocks new sign-ins and the auth middleware rejects the live session on its
# next request. Moving it to TEST_STUDENT_EMAILS demotes it on the next sign-in;
# mere removal leaves the stored role unchanged, so delete or demote the row if
# that matters.
# TEST_TEACHER_EMAILS=owner-tester@gmail.com

# Browser origin for local CORS and cookies.
CLIENT_URL=http://localhost:3000

# Extra browser origins allowed to call the API with cookies, comma separated.
# Outside production, localhost:3000, 127.0.0.1:3000 and *.trycloudflare.com quick tunnels are allowed.
# Add your own deployment origin here, for example:
# CLIENT_URLS=https://your-own-frontend.vercel.app
