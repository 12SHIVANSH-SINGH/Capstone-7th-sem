@startuml
!pragma layout smetana
title Check-in flow — server-minted phone-to-phone relay (built; classroom rehearsal pending)

skinparam defaultFontName "Arial"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundCorner 8
skinparam wrapWidth 240
skinparam activity {
  BackgroundColor #EEF2FF
  BorderColor #4F46E5
}
skinparam note {
  BackgroundColor #FFFBEB
  BorderColor #D97706
}

|Teacher phone|
start
:Open /teacher/check-in;
:Choose class and tap\nStart and play round 0;

|Server|
:Create one active session;
:Mint round-0 key K0\n15^7 space · 2-minute key TTL;

|Teacher phone|
:Play K0 from the front;
:Show live round, countdown,\npending signal and evidence;

|Student phone — /student/check-in|
:Read notice and accept once\n(choice stored for this session);
:Tap Join once;
:Discover live sessions\nGET /student/check-in-sessions/active\n(no key and no pending signal);
:Listen with mic and decode K\nraw audio stays on the phone;
:Try displayed round through +2\n(the frame carries only the key);
:Build canonical message\nsession + wave + key + student;
:Sign with the bound P-256 device key;
:POST /api/v1/check-in-sessions/:id/proofs;

|Server|
:Origin guard · auth · student role\n60/min per student;
if (Enrolled, approved device,\nno pending device change?) then (no)
  :400 / 401 / 403 / 429;
  stop
endif
:Load active session and verify signature;
if (Current or pending round,\nkey fresh and matching?) then (no)
  :409 stale or wrong round;
  stop
endif
if (New proof?) then (yes)
  :Record signed evidence\nunique per student + round;
else (exact retry)
  :Return 200 duplicate\nno second evidence row;
endif
if (Proof round is current?) then (yes)
  :Mint pending K(n+1)\nkeep its 2-minute lifetime;
else (proof round is pending)
  :Atomically promote the pending key;
  :Archive the old key\nin bounded 20-entry history;
  :Mint pending K(n+2);
endif
:attendanceDecided = false;
:Return the next signal only\nto this proving phone;

|Student phone|
:Play the returned signal 2-3 times;
:Return to listening automatically\n(no reload and no second Join);

|Teacher phone|
:5-second poll sees the round advance;
:Stop old round audio if it was playing;
:Evidence card updates\nstudent · round · time · per-round counts;
if (Manual fallback needed?) then (yes)
  :Nudge plays fresh pending\nelse the current round;
  :Advanced → Advance round\nrequires accepted evidence;
  |Server|
  :Promote a fresh pending key\nwith its original expiry,\nor mint a new two-minute key;
  |Teacher phone|
  :Play the new round only if needed;
else (no)
  :Student phones carry the next round;
endif
:Close the session;

|Server|
:Clear pending state;
:Return neither current key nor pending;
:Keep evidence for about 24 hours;

|Gated future — not built|
:ID round + neighbour reports;
:Scoring + teacher review queue;
stop

@enduml
