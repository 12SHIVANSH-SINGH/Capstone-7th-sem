@startuml
!pragma layout smetana
title Check-in flow — evidence-only pilot (wave advancement + teacher evidence view built)

skinparam defaultFontName "Arial"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundCorner 8
skinparam wrapWidth 240
skinparam activity {
  BackgroundColor #EEF2FF
  BorderColor #4F46E5
}
skinparam note {
  BackgroundColor #FFFBEB
  BorderColor #D97706
}

|Teacher phone|
start
:Open /teacher/check-in;
:Choose class and start session;

|Server|
:Server mints wave-0 key K0\n15^7 space · 2-minute key TTL;

|Teacher phone|
:Play K0 repeatedly from the front;

|Student phone — /student/check-in|
:Open the shell and read the\nretention/consent notice;
:Confirm consent, then tap Join;
:Discover the live session\nGET /student/check-in-sessions/active\n(no key returned);
:Listen with mic and decode K0\nraw audio stays on the phone;
:Build canonical message\nsession + wave + key + student;
:Sign with the bound P-256 device key;
:POST /api/v1/check-in-sessions/:id/proofs;
:Show the recorded evidence\nand poll live/closed state;

|Server|
:Origin guard · auth · student role\n60/min per student;
if (Enrolled, approved device,\nno pending device change?) then (no)
  :401 / 403 / 429;
  stop
endif
:Load session and verify signature;
if (Proof already recorded?) then (same key)
  :200 duplicate\nno second row;
else (new)
  if (Active, current wave,\nkey fresh, key matches?) then (no)
    :400 / 409;
    stop
  endif
  :201 record evidence\nstudent · wave · key · device · signature;
  :TTL ~24 h;
endif
:attendanceDecided = false;

|Teacher phone|
:Open the read-only evidence card\nstudent email · wave · recorded time\nper-wave counts · no attendance decision\n(no key, signature or fingerprint);

:Choose "Advance wave";
if (At least one accepted proof\nin the current wave?) then (no)
  :409 · keep the current wave;
  stop
endif
:Confirm the advance;

|Server|
:Atomically match session + wave;
:Archive the old key in bounded history\n(20 entries maximum);
:Mint a fresh two-minute key for wave + 1;
:Return the teacher view\n(wave history has no keys);

|Teacher phone|
:Play the new key from the front;
note right
  The student shell stops listening if
  the wave changes mid-capture, so a
  frame from the old key is not submitted.
end note
:Repeat the cascade for the next wave;

|Teacher phone|
:Close the session;

|Gated future — not built|
:Student does not receive wave keys\nor key history;
:ID round + neighbour reports;
:Scoring + teacher review queue;
:Attendance locked same day;
stop

@enduml
