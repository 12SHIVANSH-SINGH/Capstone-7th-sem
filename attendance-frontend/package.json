{
  "name": "attendance-frontend",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "axios": "^1.7.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.1.5",
    "react-scripts": "5.0.1"
  },
  "scripts": {
    "start": "react-scripts start",
    "start:shared": "HOST=0.0.0.0 DANGEROUSLY_DISABLE_HOST_CHECK=true REACT_APP_API_URL=/api/v1 react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test --passWithNoTests",
    "test:acoustic": "node --test src/acoustic/fsk.node-tests.js src/acoustic/lab.node-tests.js src/acoustic/worklet.node-tests.js src/acoustic/link.node-tests.js src/acoustic/pcm-worklet.node-tests.js",
    "test:proof": "node --test src/acoustic/proof.node-tests.js",
    "test:checkin": "node --test src/components/teacher/checkInSessionView.node-tests.js",
    "test:auth": "node --test src/utils/auth.node-tests.js",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "http-proxy-middleware": "^2.0.10"
  }
}
